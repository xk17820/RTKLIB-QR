+    if(m->rpolicy>=2) {
+        if(x[k+3]<.5){out[0]=1.;return 1;}
+        d=fmax(expm1(fmin(8.,fabs(x[k+8]))),expm1(fmin(8.,fabs(x[k+9]))));
+        gate=m->rpolicy==3?1.:fmin(1.,fmax(0.,(d-m->guard_anchor)/m->guard_width));
+        out[0]=1.+gate*fmax(out[0]-1.,0.);return 1;
+    }
